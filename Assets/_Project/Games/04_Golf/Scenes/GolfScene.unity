--- !u!114 &1543339218
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1543339216}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d68b38bf96e36004087e7b4c3678d892, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MiniGame.Golf.GolfHelpView
  _input: {fileID: 2086251355}
  _openButton: {fileID: 1125518415}
  _panel: {fileID: 1608394858}
  _text: {fileID: 1562950502}
  _helpText: "<b>\u25A0 \u30B7\u30E7\u30C3\u30C8\u306E\u6253\u3061\u65B9\uFF083\u56DE\u30BF\u30C3\u30D7\uFF09</b>\n\u2460 \u30B2\u30FC\u30B8\u3092\u30BF\u30C3\u30D7 \u2192 \u767D\u3044\u7DDA\u304C\u53F3\u3078\u52D5\u304F\n\u2461 \u3082\u3046\u4E00\u5EA6\u30BF\u30C3\u30D7 \u2192 \u5F37\u3055\u304C\u6C7A\u307E\u308B\uFF08\u8D64\u3044\u7DDA\uFF09\n\u2462 \u623B\u3063\u3066\u304F\u308B\u767D\u3044\u7DDA\u3092<color=#F2BF33>\u9EC4\u8272</color>\u3067\u6B62\u3081\u308B\n\n<b>\u25A0 \u5F37\u3055\u3068\u98DB\u8DDD\u96E2</b>\n\u30FB\u98DB\u8DDD\u96E2\u306F\u5F37\u3055\u306E2\u4E57\u304F\u3089\u3044\uFF087\u5272\u3067\u7D04\u534A\u5206\u30015\u5272\u3067\u7D041/4\uFF09\n\u30FB\u7740\u5730\u4E88\u6E2C\u306F\u30D5\u30EB\u30D1\u30EF\u30FC\u306E\u4F4D\u7F6E\u3002\u98A8\u3068\u50BE\u659C\u306F\u5165\u3063\u3066\u3044\u306A\u3044\n\n<b>\u25A0 \u9EC4\u8272\u3067\u6B62\u3081\u308B\u4F4D\u7F6E</b>\n\u30FB\u3069\u771F\u3093\u4E2D \u2192 \u30CA\u30A4\u30B9\u30B7\u30E7\u30C3\u30C8\uFF08\u307E\u3063\u3059\u3050\uFF09\n\u30FB\u53F3\u5BC4\u308A\uFF08\u65E9\u3081\uFF09\u2192 \u30B9\u30E9\u30A4\u30B9\uFF08\u53F3\u306B\u66F2\u304C\u308B\uFF09\n\u30FB\u5DE6\u5BC4\u308A\uFF08\u9045\u3081\uFF09\u2192 \u30D5\u30C3\u30AF\uFF08\u5DE6\u306B\u66F2\u304C\u308B\uFF09\n\u30FB\u9EC4\u8272\u306E\u5916 \u2192 \u30DF\u30B9\u30B7\u30E7\u30C3\u30C8\uFF08\u5927\u304D\u304F\u66F2\u304C\u3063\u3066\u98DB\u3070\u306A\u3044\uFF09\n\u30FB\u30D0\u30F3\u30AB\u30FC\u3067\u306F\u9EC4\u8272\u304C\u305B\u307E\u304F\u306A\u308B\n\n<b>\u25A0 \u30B9\u30D4\u30F3\uFF08\u53F3\u4E0B\u306E\u30DC\u30BF\u30F3\uFF09</b>\n\u30FB\u30D0\u30C3\u30AF \u2192 \u7740\u5730\u3067\u3059\u3050\u6B62\u307E\u308B\uFF08\u30B0\u30EA\u30FC\u30F3\u3092\u72D9\u3046\u3068\u304D\uFF09\n\u30FB\u30C8\u30C3\u30D7 \u2192 \u7740\u5730\u5F8C\u306B\u3088\u304F\u8EE2\u304C\u308B\uFF08\u8DDD\u96E2\u3092\u304B\u305B\u3050\u3068\u304D\uFF09\n\u30FB\u30D1\u30BF\u30FC\u3067\u306F\u4F7F\u3048\u306A\u3044\n\n<b>\u25A0 \u305D\u306E\u307B\u304B</b>\n\u30FB\u753B\u9762\u3092\u5DE6\u53F3\u306B\u30C9\u30E9\u30C3\u30B0 / \u25C0\u25B6 \u3067\u65B9\u5411\u3092\u5909\u3048\u308B\n\u30FB\u771F\u3093\u4E2D\u306E\u30DC\u30BF\u30F3\u3067\u30AF\u30E9\u30D6\u3092\u5207\u308A\u66FF\u3048\n\u30FB\u300C\u5168\u4F53\u300D\u3092\u62BC\u3057\u3066\u3044\u308B\u9593\u30DB\u30FC\u30EB\u5168\u4F53\u304C\u898B\u3048\u308B\n\n\uFF08\u30BF\u30C3\u30D7\u3067\u9589\u3058\u308B\uFF09"
